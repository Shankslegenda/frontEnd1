/* Step 13: Element Selectors */
body {
    margin: 0;
    padding: 2rem;
    color: #333333;
    line-height: 1.6;
}

/* Step 19: Sizing Units (rem, em, px, %) */
h1 {
    font-size: 2.5rem; /* rem sizing */
    margin-bottom: 0.5em; /* em sizing */
}

h2 {
    font-size: 1.75rem;
    color: #2c3e50;
    border-bottom: 2px solid #3498db;
    padding-bottom: 5px;
}

h3 {
    font-size: 1.2rem;
    color: #34495e;
}

p {
    font-size: 1rem;
}

/* Step 14: ID Selector */
#main-heading {
    color: #2c3e50;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Step 14: Class Selector */
.highlight {
    background-color: #ffeaa7;
    padding: 2px 6px;
    border-radius: 4px;
    color: #d35400;
    text-decoration: none;
    font-weight: bold;
}

/* Step 16 & 17: Div Styling & Box Model (Margin, Padding, Border) */
.card-box {
    background-color: #ffffff;
    max-width: 800px;
    margin: 0 auto 20px auto; /* Box model: margin */
    padding: 20px;            /* Box model: padding */
    border: 1px solid #e0e0e0; /* Box model: border */
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.profile-img {
    width: 50px; /* px sizing */
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #3498db;
}

.section-block {
    margin-bottom: 30px;
}

/* Step 5: Table Styling */
table {
    width: 100%; /* % sizing */
    border-collapse: collapse;
    margin-top: 10px;
}

table, th, td {
    border: 1px solid #cccccc;
}

th, td {
    padding: 10px;
    text-align: left;
}

th {
    background-color: #3498db;
    color: #ffffff;
}

/* Step 6: Layout Table */
.layout-table {
    border: 2px dashed #bdc3c7;
}

.menu-col {
    width: 30%;
    background-color: #ecf0f1;
    vertical-align: top;
}

.content-col {
    width: 70%;
    background-color: #ffffff;
    vertical-align: top;
}

/* Step 8: Form Styling */
.user-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 400px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: bold;
    margin-bottom: 5px;
}

.form-group input {
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

.btn {
    padding: 10px 20px;
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
}

.btn:hover {
    background-color: #2980b9;
}

/* Step 18: Positioning Rules */
.pos-box {
    padding: 10px;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    margin-bottom: 10px;
}

.static-box {
    background-color: #95a5a6;
    position: static;
}

.relative-box {
    background-color: #e67e22;
    position: relative;
    top: 10px;
    left: 20px;
}

.pos-container {
    position: relative;
    height: 80px;
    background-color: #ecf0f1;
    border: 1px dashed #bdc3c7;
}

.absolute-box {
    background-color: #9b59b6;
    position: absolute;
    bottom: 10px;
    right: 10px;
}

/* Step 20: Float and Clear */
.float-container {
    background-color: #f9f9f9;
    padding: 10px;
    border: 1px solid #ddd;
}

.float-box {
    width: 45%;
    padding: 15px;
    color: white;
    font-weight: bold;
    box-sizing: border-box;
}

.float-left {
    float: left;
    background-color: #1abc9c;
}

.float-right {
    float: right;
    background-color: #e74c3c;
}

.clear-fix {
    clear: both;
    background-color: #34495e;
    color: white;
    padding: 10px;
    margin-top: 10px;
    text-align: center;
}
